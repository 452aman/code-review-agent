  "retrieval": [
    {
      "query": "user input concatenated into a SQL query string",
      "expect": "OWASP-A03"
    },
    {
      "query": "password hashed with md5",
      "expect": "OWASP-A02"
    },
    {
      "query": "api key written directly in source code",
      "expect": "SEC-SECRETS"
    },
    {
      "query": "list used as a default argument value",
      "expect": "PY-MUTABLE-DEFAULT"
    },
    {
      "query": "except block that just passes and hides errors",
      "expect": "PY-EXCEPT"
    },
    {
      "query": "time.sleep inside an async function blocks the event loop",
      "expect": "BUG-ASYNC"
    },
    {
      "query": "file opened but never closed",
      "expect": "BUG-RESOURCE"
    },
    {
      "query": "pickle loads data from an untrusted source",
      "expect": "OWASP-A08"
    },
    {
      "query": "assigning user text to innerHTML",
      "expect": "OWASP-XSS"
    },
    {
      "query": "server fetches a URL supplied by the user",
      "expect": "SEC-SSRF"
    },
    {
      "query": "check a row exists then insert it, two requests can interleave",
      "expect": "BUG-RACE"
    }
  ]
